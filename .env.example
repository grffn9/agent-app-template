# Copy to .env and fill in real values. Never commit .env.
# Every variable the app reads is listed here with a placeholder.

# API keys for the API backends in config/connections.yaml. Leave a key empty to skip that account.
# The Claude API also works without a key once you run "ant auth login".
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# A second Claude Code sign-in folder, and Codex's sign-in folder. Empty means the CLI's default.
CLAUDE_CONFIG_DIR_FOR_APP=
CODEX_HOME=

# Optional: another connections file, and where the usage ledger is kept.
APP_CONFIG=
APP_DATA_DIR=
